# Server-only credentials. Never commit real secrets.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/snapycall_pilot?schema=public
DIRECT_URL=postgresql://user:password@127.0.0.1:5432/snapycall_pilot?schema=public
ADMIN_EMAIL=admin@example.com
# One-time bootstrap secret, minimum 12 characters, maximum 72 UTF-8 bytes.
# Remove ADMIN_PASSWORD after the first successful startup.
ADMIN_PASSWORD=
SESSION_SIGNING_KEY=
# 32 random bytes, represented as 64 hex characters or 256-bit base64
AI_ENCRYPTION_KEY=
NODE_ENV=development
PORT=3000
