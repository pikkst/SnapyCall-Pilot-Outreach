# Server-only credentials. Never commit real secrets.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/snapycall_pilot?schema=public
DIRECT_URL=postgresql://user:password@127.0.0.1:5432/snapycall_pilot?schema=public
ADMIN_EMAIL=admin@example.com
# One-time bootstrap secret, minimum 12 characters, maximum 72 UTF-8 bytes.
# Remove ADMIN_PASSWORD after the first successful startup.
ADMIN_PASSWORD=
SESSION_SIGNING_KEY=
# 32 random bytes, represented as 64 hex characters or 256-bit base64
AI_ENCRYPTION_KEY=
NODE_ENV=development
PORT=3000

# Free discovery: explicitly approved public RSS/Atom feed URLs, comma-separated.
# No external paid search provider is needed. Leave empty to disable scans.
DISCOVERY_FEED_URLS=


# AI98: Tavily retrieval credential belongs to the server operator, never
# to the browser or per-user Gemini BYOK storage.
# The exact Gemini 3 pilot price is approved in server code; these controls
# remain mandatory and default OFF for any new deployment.
# Enable only after Tavily account hard cap and permitted use are verified.
TAVILY_API_KEY=
TAVILY_DUAL_PROVIDER_ENABLED=false
TAVILY_ACCOUNT_CAP_VERIFIED=false

# Optional Google OAuth (partner login, read-only Sheets/Forms consent).
# All callback URLs must use HTTPS and match their exact server callback path.
# For local OAuth, use a dedicated HTTPS development hostname or trusted tunnel
# with matching Google Cloud OAuth client settings. Do not point callbacks at
# production while developing against localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DATA_REDIRECT_URI=
# Optional Gmail consent foundation; does NOT enable outreach sending.
GOOGLE_GMAIL_REDIRECT_URI=
GMAIL_OAUTH_ENABLED=false

# Optional partner workspace invitation delivery via Resend.
# Leave unset to disable invitation mail delivery in local development.
RESEND_API_KEY=
PARTNER_INVITE_FROM=

# Research / inspection / autonomous worker gates. All default to OFF.
# These do NOT authorize paid API calls; owner approval, per-call prices,
# live provider hard caps, auth, quotas and budgets remain mandatory.
AI_WEB_RESEARCH_ENABLED=false
AI_GEMINI3_SINGLE_TEST_ENABLED=false
AI_GEMINI3_SINGLE_TEST_OWNER_ID=
AI_PUBLIC_CONTACT_INSPECTION_ENABLED=false
AI_AGENT_RESEARCH_ENABLED=false
AI_GROUNDING_RESOLUTION_ENABLED=false
AI_EMAIL_TRIAGE_ENABLED=false
AI_CONTACT_BATCH_ENABLED=false
AI_PERSON_SOURCE_APPROVAL_ENABLED=false
AI_PERSON_SOURCE_EXECUTOR_ENABLED=false
AI_AGENT_EXECUTOR_ENABLED=false
AI_AGENT_AUTORUN_ENABLED=false

# Only when placed behind a controlled trusted reverse proxy.
# Leave unset for direct local localhost development.
# TRUST_PROXY=1
