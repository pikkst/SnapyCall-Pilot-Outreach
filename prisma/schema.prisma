generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Candidate {
  id String @id @default(cuid())
  // Null records are historical admin-only data until an audited ownership migration.
  workspaceId String?
  workspace Partner? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  kind String @default("EXPERT")
  name String
  email String?
  emailNormalized String? @unique
  discoveryKey String? @unique
  expertProfileUrl String?
  profileReviewed Boolean @default(false)
  category String
  region String?
  onlineEnglish Boolean @default(false)
  sourceUrl String
  sourceCollectedAt DateTime @default(now())
  legalBasis String?
  contactReviewed Boolean @default(false)
  suppressed Boolean @default(false)
  status String @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drafts OutreachDraft[]
  evidence CandidateEvidence[]
  @@index([workspaceId, createdAt])
  @@index([category, status])
}
model AiSetting {
  id String @id @default(cuid())
  // BYOK: each Google user owns one credential; never bind key uniqueness to workspace.
  ownerId String @unique
  provider String
  model String
  encryptedApiKey String
  keyFingerprint String
  updatedAt DateTime @updatedAt
}
model OutreachDraft {
  id String @id @default(cuid())
  workspaceId String?
  workspace Partner? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  subject String
  body String
  model String
  provider String
  approvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
  @@index([candidateId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([action, createdAt])
}

model AdminCredential {
  id String @id
  email String
  passwordHash String
  createdAt DateTime @default(now())
}

model CandidateEvidence {
  id String @id @default(cuid())
  workspaceId String?
  workspace Partner? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  kind String
  sourceUrl String
  normalizedUrl String
  note String?
  capturedAt DateTime @default(now())
  capturedBy String @default("admin")
  @@unique([candidateId, kind, normalizedUrl])
  @@index([normalizedUrl])
  @@index([workspaceId, capturedAt])
  @@index([candidateId, capturedAt])
}

model Partner {
  id String @id @default(cuid())
  name String
  memberships PartnerMembership[]
  candidates Candidate[]
  drafts OutreachDraft[]
  candidateEvidence CandidateEvidence[]
  googleConnections PartnerGoogleConnection[]
  createdAt DateTime @default(now())
}

model PartnerUser {
  id String @id @default(cuid())
  emailNormalized String @unique
  googleSub String? @unique
  displayName String?
  memberships PartnerMembership[]
  googleConnections PartnerGoogleConnection[]
  gmailConnection PartnerGmailConnection?
  createdAt DateTime @default(now())
}

model PartnerMembership {
  id String @id @default(cuid())
  partnerId String
  userId String
  role String @default("PARTNER")
  revokedAt DateTime?
  // Invitation delivery is separate from membership authorization.
  inviteStatus String @default("PENDING")
  inviteAttempt Int @default(0)
  inviteAttemptAt DateTime?
  inviteLeaseUntil DateTime?
  inviteSentAt DateTime?
  inviteProviderId String?
  inviteErrorCode String?
  acceptedAt DateTime?
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user PartnerUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([partnerId, userId])
  @@index([userId, revokedAt])
}

model PartnerGoogleConnection {
  id String @id @default(cuid())
  partnerId String
  userId String
  googleSub String
  encryptedRefreshToken String
  scope String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user PartnerUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([partnerId, userId])
  @@index([userId])
}

model PartnerGmailConnection {
  id String @id @default(cuid())
  userId String @unique
  googleSub String
  encryptedRefreshToken String
  scope String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user PartnerUser @relation(fields: [userId], references: [id], onDelete: Restrict)
}
