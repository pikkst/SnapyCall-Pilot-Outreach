generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Candidate {
  id String @id @default(cuid())
  // Null records are historical admin-only data until an audited ownership migration.
  workspaceId String?
  workspace Partner? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  kind String @default("EXPERT")
  name String
  email String?
  emailNormalized String?
  discoveryKey String?
  expertProfileUrl String?
  profileReviewed Boolean @default(false)
  category String
  region String?
  onlineEnglish Boolean @default(false)
  sourceUrl String?
  // Unverified provider citation is not an identity or contact proof.
  researchCitationUrl String?
  sourceCollectedAt DateTime @default(now())
  legalBasis String?
  contactReviewed Boolean @default(false)
  suppressed Boolean @default(false)
  status String @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drafts OutreachDraft[]
  evidence CandidateEvidence[]
  directEmailObservation CandidateDirectEmailObservation?
  emailVerification CandidateEmailVerification?
  mailboxVerification CandidateMailboxVerification?
  researchObservations ResearchCampaignObservation[]
  @@unique([workspaceId, emailNormalized])
  @@unique([workspaceId, discoveryKey])
  @@index([workspaceId, createdAt])
  @@index([category, status])
}
model AiSetting {
  id String @id @default(cuid())
  // BYOK: each Google user owns one credential; never bind key uniqueness to workspace.
  ownerId String @unique
  provider String
  model String
  encryptedApiKey String
  keyFingerprint String
  updatedAt DateTime @updatedAt
}
model OutreachDraft {
  id String @id @default(cuid())
  workspaceId String?
  workspace Partner? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  subject String
  body String
  model String
  provider String
  approvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
  @@index([candidateId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([action, createdAt])
}

model AdminCredential {
  id String @id
  email String
  passwordHash String
  createdAt DateTime @default(now())
}

model CandidateEvidence {
  id String @id @default(cuid())
  workspaceId String?
  workspace Partner? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  kind String
  sourceUrl String
  normalizedUrl String
  note String?
  capturedAt DateTime @default(now())
  capturedBy String @default("admin")
  @@unique([candidateId, kind, normalizedUrl])
  @@index([normalizedUrl])
  @@index([workspaceId, capturedAt])
  @@index([candidateId, capturedAt])
}

model Partner {
  id String @id @default(cuid())
  name String
  memberships PartnerMembership[]
  candidates Candidate[]
  researchCampaigns ResearchCampaign[]
  drafts OutreachDraft[]
  candidateEvidence CandidateEvidence[]
  directEmailObservations CandidateDirectEmailObservation[]
  emailVerifications CandidateEmailVerification[]
  mailboxVerifications CandidateMailboxVerification[]
  googleConnections PartnerGoogleConnection[]
  createdAt DateTime @default(now())
}

model PartnerUser {
  id String @id @default(cuid())
  emailNormalized String @unique
  googleSub String? @unique
  displayName String?
  jobTitle String?
  organizationName String?
  businessPhone String?
  publicWebsite String?
  emailSignature String? @db.VarChar(1000)
  memberships PartnerMembership[]
  googleConnections PartnerGoogleConnection[]
  gmailConnection PartnerGmailConnection?
  createdAt DateTime @default(now())
}

model PartnerMembership {
  id String @id @default(cuid())
  partnerId String
  userId String
  role String @default("PARTNER")
  revokedAt DateTime?
  // Invitation delivery is separate from membership authorization.
  inviteStatus String @default("PENDING")
  inviteAttempt Int @default(0)
  inviteAttemptAt DateTime?
  inviteLeaseUntil DateTime?
  inviteSentAt DateTime?
  inviteProviderId String?
  inviteErrorCode String?
  acceptedAt DateTime?
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user PartnerUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([partnerId, userId])
  @@index([userId, revokedAt])
}

model PartnerGoogleConnection {
  id String @id @default(cuid())
  partnerId String
  userId String
  googleSub String
  encryptedRefreshToken String
  scope String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user PartnerUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([partnerId, userId])
  @@index([userId])
}

model PartnerGmailConnection {
  id String @id @default(cuid())
  userId String @unique
  googleSub String
  encryptedRefreshToken String
  scope String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user PartnerUser @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model ResearchDailyQuota {
  // Durable conservative reservations; requests that fail still count.
  scopeKey String
  dayUtc DateTime @db.Date
  attempts Int @default(0)
  @@id([scopeKey, dayUtc])
}

model ResearchUserLimits {
  // The personal BYOK limit applies independently within each member workspace.
  ownerId String @id
  dailyLimit Int @default(2)
  maxCandidates Int @default(10)
  maxConcurrent Int @default(1)
  updatedAt DateTime @updatedAt
}

model ResearchRunLease {
  id String @id @default(cuid())
  workspaceId String
  userId String
  expiresAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, expiresAt])
  @@index([workspaceId, userId, expiresAt])
}


model ResearchOwnerBudget {
  // One billing currency across Gemini, OpenAI and Claude API integrations.
  ownerId String @id
  monthlyLimitCents Int
  updatedAt DateTime @updatedAt
}

model ResearchSpendMonth {
  ownerId String
  monthUtc DateTime @db.Date
  reservedCents Int @default(0)
  settledCents Int @default(0)
  @@id([ownerId, monthUtc])
}

model ResearchSpendReservation {
  // Idempotency key is generated by the server, never from the browser.
  id String @id
  ownerId String
  workspaceId String
  monthUtc DateTime @db.Date
  reservedCents Int
  chargedCents Int?
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  settledAt DateTime?
  @@index([ownerId, monthUtc, status])
}


model ResearchReconciliationOutbox {
  // One row per distinct oldest-unresolved reservation incident. The key is
  // a server-side SHA-256 digest; no tenant or reservation identifier is sent.
  dedupeKey String @id
  status String @default("PENDING")
  firstDetectedAt DateTime @default(now())
  lastDetectedAt DateTime @default(now())
  staleCount Int
  estimatedHeldCents Int
  // No recipient, raw reservation ID, API key or email stored in the outbox.
  // A leased send uses the same provider idempotency key on every retry.
  // Never reset the attempt timestamp after an ambiguous provider timeout.
  attemptAt DateTime?
  leaseUntil DateTime?
  attempts Int @default(0)
  sentAt DateTime?
  providerId String?
  errorCode String?
  @@index([status, firstDetectedAt])
}

model ResearchCampaign {
  id String @id @default(cuid())
  workspaceId String
  workspace Partner @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ownerId String
  idempotencyKey String
  query String
  targetCount Int
  planVersion String
  status String @default("QUEUED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks ResearchCampaignTask[]
  observations ResearchCampaignObservation[]
  manualSources ResearchCampaignSource[]
  personSourceJobs ResearchPersonSourceJob[]
  personSourceApproval ResearchPersonSourceApproval?
  personSourceCycles ResearchPersonSourceCycle[]
  contactBatch ResearchContactBatch?
  approvedRun ResearchCampaignRun?
  fullRun ResearchFullRun?
  // This is a separate no-provider-call authorization for reading public profiles.
  emailTriageStatus String @default("IDLE")
  emailTriageAuthorizedAt DateTime?
  emailTriageExpiresAt DateTime?
  emailTriageMaxPages Int @default(0)
  // Explicit one-shot authorization for unverified Google redirect resolution.
  groundingRunStatus String @default("IDLE")
  groundingRunMaxSources Int @default(0)
  groundingRunApprovedAt DateTime?
  groundingRunExpiresAt DateTime?

  @@unique([workspaceId, ownerId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model ResearchCampaignTask {
  id String @id @default(cuid())
  campaignId String
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  taskIndex Int
  taskKey String
  query String
  region String
  facet String
  resultLimit Int
  status String @default("QUEUED")
  attempts Int @default(0)
  // A lease is a fencing token; stale workers must not commit results.
  leaseToken String?
  leaseUntil DateTime?
  nextAttemptAt DateTime?
  lastErrorCode String?
  observedCount Int @default(0)
  completedAt DateTime?
  // No provider execution until a separately reviewed budgeted executor exists.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  observations ResearchCampaignObservation[]
  @@unique([campaignId, taskIndex])
  @@unique([campaignId, taskKey])
  @@index([status, nextAttemptAt, leaseUntil])
}

model ResearchCampaignObservation {
  id String @id @default(cuid())
  campaignId String
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  taskId String
  task ResearchCampaignTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // A citation is provider-grounded research, not independent profile or email verification.
  evidenceKey String
  name String
  category String
  citationUrl String
  rationale String
  status String @default("UNVERIFIED")
  // Independent source resolution: immutable original citationUrl is preserved.
  // SOURCE_HINT is not proof of person identity or email ownership.
  groundingStatus String @default("UNCHECKED")
  groundingResolvedUrl String? @db.VarChar(2048)
  groundingProvenance String?
  groundingCode String?
  groundingResolvedAt DateTime?
  // A committed claim is not retried automatically after an uncertain HEAD.
  groundingLeaseToken String?
  groundingLeaseUntil DateTime?
  // Non-billable public-profile inspection is not contact promotion.
  emailTriageStatus String @default("UNCHECKED")
  emailTriageCode String?
  emailTriageLeaseToken String?
  emailTriageLeaseUntil DateTime?
  emailTriageEmail String?
  emailTriageDigest String?
  emailTriageAt DateTime?
  // Independently fetched and explicitly person-email-attributed public page.
  // Never set merely from a provider-generated URL.
  personSourceUrl String? @db.VarChar(2048)
  personSourceProvenance String?
  personSourceVerifiedAt DateTime?
  // A research observation is linked to a workspace contact only after
  // explicit source-backed, named-email review. Never by name alone.
  candidateId String?
  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  personSourceJob ResearchPersonSourceJob?
  contactBatchItem ResearchContactBatchItem?
  observedAt DateTime @default(now())
  @@unique([campaignId, evidenceKey])
  @@index([campaignId, observedAt, id])
  @@index([taskId])
  @@index([candidateId])
  @@index([campaignId, emailTriageStatus, id])
}

model CandidateEmailVerification {
  // DNS checks are domain-level evidence, never mailbox-level proof.
  // One snapshot per Candidate; changing their email replaces the snapshot.
  id String @id @default(cuid())
  workspaceId String
  workspace Partner @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String @unique
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  emailNormalized String
  checkType String @default("DNS_MX")
  status String @default("UNKNOWN")
  reason String
  domainAcceptsMail Boolean?
  checkedAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId, expiresAt])
}

model CandidateMailboxVerification {
  // Provider result is a technical signal; person identity, consent and
  // invitation eligibility are independent gates and never set by this row.
  id String @id @default(cuid())
  workspaceId String
  workspace Partner @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String @unique
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  emailNormalized String
  provider String
  adapterVersion String
  status String @default("UNKNOWN")
  reason String
  billableAttemptUncertain Boolean @default(false)
  checkedAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId, expiresAt])
}

model CandidateDirectEmailObservation {
  id String @id @default(cuid())
  workspaceId String
  workspace Partner @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  candidateId String @unique
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  personName String
  emailNormalized String
  profileUrl String
  evidenceDigest String
  // Explicit labeled name/email on an inspected page is a REVIEW hint,
  // never confirmed individual identity or permission to send.
  status String @default("REVIEW_REQUIRED")
  inspectedAt DateTime
  reviewedAt DateTime?
  reviewedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId, inspectedAt])
}


model ResearchContactBatch {
  id String @id @default(cuid())
  campaignId String @unique
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  workspaceId String
  ownerId String
  // User reviewed an exact stable list of names, emails, source URLs and digests.
  manifestHash String @db.Char(64)
  itemCount Int
  status String @default("APPROVED")
  approvedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items ResearchContactBatchItem[]

  @@index([status, updatedAt])
  @@index([workspaceId, ownerId])
}

model ResearchContactBatchItem {
  id String @id @default(cuid())
  batchId String
  batch ResearchContactBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observationId String @unique
  observation ResearchCampaignObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  expectedDigest String @db.Char(64)
  status String @default("QUEUED")
  attempts Int @default(0)
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  resultCode String?
  candidateId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, status, createdAt])
}

model ResearchPersonSourceApproval {
  id String @id @default(cuid())
  campaignId String @unique
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  workspaceId String
  ownerId String
  provider String
  model String
  priceVersion String
  worstCasePerCallCents Int
  maxCalls Int
  maxWorstCaseCents Int
  eligibleJobCount Int
  // Frozen set of queued source-resolution job fingerprints.
  jobSnapshotHash String @db.Char(64)
  // Separate explicit scope for bounded robots-respecting public page reads.
  publicInspectionAuthorized Boolean @default(false)
  status String @default("APPROVED")
  startedCalls Int @default(0)
  committedWorstCaseCents Int @default(0)
  approvedAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([workspaceId, ownerId])
}

// Continuation of a fully approved source run. Each cycle freezes only
// previously unattempted observation jobs, never reauthorizing a paid call.
model ResearchPersonSourceCycle {
  id String @id @default(cuid())
  campaignId String
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  workspaceId String
  ownerId String
  cycleIndex Int
  provider String
  model String
  priceVersion String
  worstCasePerCallCents Int
  maxCalls Int
  maxWorstCaseCents Int
  eligibleJobCount Int
  jobSnapshotHash String @db.Char(64)
  status String @default("APPROVED")
  startedCalls Int @default(0)
  committedWorstCaseCents Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, cycleIndex])
  @@index([status, updatedAt])
  @@index([workspaceId, ownerId])
}

model ResearchPersonSourceJob {
  id String @id @default(cuid())
  campaignId String
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  observationId String @unique
  observation ResearchCampaignObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  // Hash of the exact persisted observation used when this job was enqueued.
  // Any later change must be reconciled, never silently accepted.
  evidenceFingerprint String @db.Char(64)
  reason String
  status String @default("QUEUED")
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  spendReservationId String? @db.Uuid
  researchLeaseId String? @db.Uuid
  // 0 belongs to the initial immutable approval; >0 is an explicit continuation batch.
  cycleIndex Int @default(0)
  // Provider-cited source proposal only; not independently verified evidence.
  proposedSourceUrl String? @db.VarChar(2048)
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status, createdAt])
  @@index([status, leaseUntil])
}

model ResearchCampaignSource {
  id String @id @default(cuid())
  campaignId String
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  // A user-provided URL is a research input, never person/email evidence.
  normalizedUrl String @db.VarChar(2048)
  normalizedUrlHash String @db.Char(64)
  sourceKind String @default("USER_URL")
  status String @default("PENDING_ENRICHMENT")
  createdAt DateTime @default(now())
  @@unique([campaignId, normalizedUrlHash])
  @@index([campaignId, status, createdAt])
}

// One explicit approval covers bounded discovery, source lookup and public
// inspection. This never authorizes Candidate acceptance or email sending.
model ResearchFullRun {
  id String @id @default(cuid())
  campaignId String @unique
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  workspaceId String
  ownerId String
  provider String
  model String
  priceVersion String
  targetQualifiedContacts Int
  maxDiscoveryCalls Int
  maxSourceCalls Int
  maxEmailInspectionPages Int
  maxDiscoveryWorstCaseCents Int
  maxSourceWorstCaseCents Int
  maxTotalWorstCaseCents Int
  // These are distinct from Candidate acceptance and mail-send permissions.
  publicInspectionAuthorized Boolean @default(false)
  status String @default("DISCOVERY")
  lastCode String?
  approvedAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([workspaceId, ownerId])
}

model ResearchCampaignRun {
  id String @id @default(cuid())
  campaignId String @unique
  campaign ResearchCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  workspaceId String
  ownerId String
  // Immutable approval limits. No browser-provided provider pricing.
  provider String
  model String
  priceVersion String
  worstCasePerCallCents Int
  maxTasks Int
  maxWorstCaseCents Int
  // Monotonic conservative commitments: never decrease on provider error.
  startedTasks Int @default(0)
  committedWorstCaseCents Int @default(0)
  status String @default("APPROVED")
  lastCode String?
  approvedAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  @@index([status, approvedAt])
  @@index([workspaceId, ownerId])
}
